{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=luxora;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "ECommerce.Api",
    "Audience": "ECommerce.Client",
    "ExpirationInMinutes": 60
  },
  "PayPal": {
    "ClientId": "YOUR_PAYPAL_SANDBOX_CLIENT_ID",
    "ClientSecret": "YOUR_PAYPAL_SANDBOX_CLIENT_SECRET",
    "BaseUrl": "https://api-m.sandbox.paypal.com/",
    "ReturnUrl": "http://localhost:4200/checkout/success",
    "CancelUrl": "http://localhost:4200/checkout/cancel"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4201"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ecommerce-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
